Smart Traffic Management System
Front end Source code (HTML, CSS, JAVASCRIPT)
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Traffic Management System</title>

<style>

/* =========================================================
   ROOT / GENERAL
========================================================= */

:root{
    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --primary-light:#eff6ff;

    --dark:#0f172a;
    --dark-2:#111827;
    --dark-3:#1e293b;

    --text:#1e293b;
    --muted:#64748b;
    --light:#f8fafc;
    --border:#e2e8f0;
    --white:#ffffff;

    --green:#10b981;
    --green-bg:#dcfce7;

    --yellow:#f59e0b;
    --yellow-bg:#fef3c7;

    --red:#ef4444;
    --red-bg:#fee2e2;

    --shadow:0 8px 30px rgba(15,23,42,.07);
    --shadow-lg:0 18px 50px rgba(15,23,42,.14);

    --sidebar-width:255px;
    --header-height:74px;

    --radius:14px;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,Helvetica,sans-serif;
    background:#f1f5f9;
    color:var(--text);
    min-height:100vh;
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.hidden{
    display:none !important;
}


/* =========================================================
   LOGIN
========================================================= */

#loginPage{
    position:fixed;
    inset:0;
    z-index:9999;

    display:flex;
    justify-content:center;
    align-items:center;

    background:
        radial-gradient(circle at 20% 20%,rgba(37,99,235,.18),transparent 30%),
        radial-gradient(circle at 80% 80%,rgba(14,165,233,.15),transparent 30%),
        #f1f5f9;

    padding:20px;
}

.login-container{
    width:420px;
    max-width:100%;

    background:rgba(255,255,255,.96);
    border:1px solid rgba(255,255,255,.8);

    padding:40px;

    border-radius:22px;

    box-shadow:var(--shadow-lg);
}

.login-logo{
    text-align:center;
    margin-bottom:32px;
}

.login-icon{
    width:76px;
    height:76px;

    margin:0 auto 16px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:22px;

    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    color:white;

    font-size:38px;

    box-shadow:0 12px 25px rgba(37,99,235,.28);
}

.login-logo h1{
    font-size:25px;
    color:#0f172a;
}

.login-logo p{
    color:var(--muted);
    font-size:14px;
    margin-top:6px;
}

.login-group{
    margin-bottom:19px;
}

.login-group label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:8px;
}

.input-wrapper{
    position:relative;
}

.login-group input{
    width:100%;
    height:48px;

    padding:0 45px 0 14px;

    border:1px solid var(--border);
    border-radius:10px;

    outline:none;

    background:#fff;

    transition:.2s;
}

.login-group input:focus{
    border-color:var(--primary);
    box-shadow:0 0 0 4px rgba(37,99,235,.1);
}

.password-toggle{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);

    background:none;
    border:none;

    color:var(--muted);
}

.login-btn{
    width:100%;
    height:49px;

    border:0;
    border-radius:10px;

    background:linear-gradient(135deg,#2563eb,#1d4ed8);

    color:#fff;
    font-weight:700;

    transition:.2s;
}

.login-btn:hover{
    transform:translateY(-1px);
    box-shadow:0 8px 20px rgba(37,99,235,.25);
}

.login-demo{
    text-align:center;
    color:var(--muted);
    font-size:12px;
    margin-top:18px;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;

    width:var(--sidebar-width);
    height:100vh;

    background:
        linear-gradient(180deg,#0f172a 0%,#111827 100%);

    color:#fff;

    padding:22px 14px;

    z-index:1000;

    overflow-y:auto;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;

    padding:5px 10px 26px;

    border-bottom:1px solid rgba(255,255,255,.08);
    margin-bottom:22px;
}

.logo-icon{
    width:46px;
    height:46px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:12px;

    background:rgba(37,99,235,.18);

    font-size:26px;
}

.logo h2{
    font-size:17px;
    line-height:1.2;
}

.logo p{
    color:#94a3b8;
    font-size:11px;
    margin-top:4px;
}

.menu-title{
    color:#64748b;
    font-size:10px;
    font-weight:800;

    letter-spacing:1px;
    text-transform:uppercase;

    padding:12px 12px 8px;
}

.menu button{
    width:100%;

    display:flex;
    align-items:center;
    gap:12px;

    padding:12px 13px;
    margin-bottom:4px;

    border:0;
    border-radius:10px;

    background:transparent;

    color:#cbd5e1;

    text-align:left;
    font-size:13px;

    transition:.2s;
}

.menu button:hover{
    background:rgba(255,255,255,.07);
    color:#fff;
}

.menu button.active{
    background:linear-gradient(
        135deg,
        rgba(37,99,235,1),
        rgba(29,78,216,.88)
    );

    color:#fff;

    box-shadow:0 8px 20px rgba(37,99,235,.2);
}

.menu-icon{
    width:20px;
    text-align:center;
    font-size:16px;
}

.sidebar-footer{
    margin-top:35px;
    padding:15px 12px;

    border-top:1px solid rgba(255,255,255,.08);

    color:#64748b;
    font-size:10px;
    line-height:1.5;
}


/* =========================================================
   MAIN
========================================================= */

.main{
    margin-left:var(--sidebar-width);
    min-height:100vh;
}


/* =========================================================
   HEADER
========================================================= */

.header{
    position:sticky;
    top:0;
    z-index:100;

    height:var(--header-height);

    background:rgba(255,255,255,.94);
    backdrop-filter:blur(12px);

    border-bottom:1px solid var(--border);

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 30px;
}

.header-left{
    display:flex;
    align-items:center;
    gap:14px;
}

.mobile-button{
    display:none;

    width:40px;
    height:40px;

    border:0;
    border-radius:9px;

    background:var(--dark);
    color:white;
}

.header-title h1{
    font-size:20px;
    font-weight:800;
}

.header-title p{
    color:var(--muted);
    font-size:12px;
    margin-top:3px;
}

.header-right{
    display:flex;
    align-items:center;
    gap:18px;
}

.clock{
    color:var(--muted);
    font-size:12px;
}

.profile{
    display:flex;
    align-items:center;
    gap:10px;
}

.profile-icon{
    width:39px;
    height:39px;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:linear-gradient(135deg,#2563eb,#1d4ed8);

    color:#fff;
    font-weight:800;
}

.profile-text strong{
    font-size:13px;
}

.profile-text p{
    color:var(--muted);
    font-size:10px;
    margin-top:2px;
}


/* =========================================================
   CONTENT
========================================================= */

.content{
    padding:28px;
}

.page{
    display:none;
    animation:pageIn .25s ease;
}

.page.active{
    display:block;
}

@keyframes pageIn{
    from{
        opacity:0;
        transform:translateY(5px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}


/* =========================================================
   DASHBOARD CARDS
========================================================= */

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:17px;

    margin-bottom:22px;
}

.card{
    position:relative;

    background:#fff;

    border:1px solid var(--border);
    border-radius:var(--radius);

    padding:20px;

    box-shadow:0 4px 15px rgba(15,23,42,.035);

    overflow:hidden;

    transition:.2s;
}

.card:hover{
    transform:translateY(-2px);
    box-shadow:var(--shadow);
}

.card::after{
    content:"";

    position:absolute;
    right:-25px;
    top:-25px;

    width:90px;
    height:90px;

    border-radius:50%;

    background:rgba(37,99,235,.05);
}

.card-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.card-title{
    color:var(--muted);

    font-size:11px;
    font-weight:700;

    text-transform:uppercase;
    letter-spacing:.4px;
}

.card-icon{
    width:38px;
    height:38px;

    border-radius:10px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:18px;
}

.icon-blue{
    background:#eff6ff;
    color:#2563eb;
}

.icon-green{
    background:#ecfdf5;
    color:#059669;
}

.icon-orange{
    background:#fff7ed;
    color:#ea580c;
}

.icon-red{
    background:#fef2f2;
    color:#dc2626;
}

.card-number{
    font-size:29px;
    font-weight:800;

    margin-top:14px;
}

.card-meta{
    display:flex;
    align-items:center;
    gap:5px;

    color:var(--muted);

    font-size:11px;
    margin-top:6px;
}

.card-meta .up{
    color:var(--green);
    font-weight:700;
}


/* =========================================================
   BOX
========================================================= */

.box{
    background:#fff;

    border:1px solid var(--border);
    border-radius:var(--radius);

    padding:22px;

    margin-bottom:20px;

    box-shadow:0 4px 15px rgba(15,23,42,.035);
}

.box-header{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:15px;

    margin-bottom:20px;
}

.box-header h2{
    font-size:17px;
}

.box-header p{
    color:var(--muted);
    font-size:12px;
    margin-top:4px;
}

.box-actions{
    display:flex;
    gap:8px;
    align-items:center;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:6px;

    min-height:38px;

    padding:0 14px;

    border:0;
    border-radius:9px;

    background:var(--primary);
    color:#fff;

    font-size:12px;
    font-weight:700;

    transition:.2s;
}

.btn:hover{
    background:var(--primary-dark);
    transform:translateY(-1px);
}

.btn-secondary{
    background:#f1f5f9;
    color:#334155;
}

.btn-secondary:hover{
    background:#e2e8f0;
}

.btn-green{
    background:var(--green);
}

.btn-green:hover{
    background:#059669;
}

.btn-danger{
    background:var(--red);
}

.btn-danger:hover{
    background:#dc2626;
}

.btn-small{
    min-height:31px;
    padding:0 10px;
    font-size:11px;
}


/* =========================================================
   TRAFFIC MONITORING
========================================================= */

.traffic-grid{
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:18px;
}

.road-item{
    border:1px solid var(--border);

    padding:17px;

    border-radius:11px;

    margin-bottom:10px;

    transition:.2s;
}

.road-item:hover{
    border-color:#bfdbfe;
    background:#fafcff;
}

.road-info{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:10px;
}

.road-name{
    font-size:13px;
    font-weight:800;
}

.road-location{
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.progress-row{
    display:flex;
    align-items:center;
    gap:10px;
}

.progress{
    height:8px;
    flex:1;

    background:#e2e8f0;

    border-radius:20px;

    overflow:hidden;
}

.progress-bar{
    height:100%;

    border-radius:20px;

    transition:width .5s ease;
}

.progress-green{
    background:linear-gradient(90deg,#10b981,#34d399);
}

.progress-orange{
    background:linear-gradient(90deg,#f59e0b,#fbbf24);
}

.progress-red{
    background:linear-gradient(90deg,#ef4444,#f87171);
}

.progress-value{
    width:35px;

    text-align:right;

    font-size:11px;
    font-weight:800;
}


/* =========================================================
   QUICK STATUS
========================================================= */

.status-summary{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.summary-box{
    padding:15px;

    border-radius:11px;

    text-align:center;

    border:1px solid var(--border);
}

.summary-box strong{
    display:block;
    font-size:21px;
}

.summary-box span{
    display:block;
    color:var(--muted);
    font-size:10px;
    margin-top:4px;
}

.summary-green{
    background:#f0fdf4;
}

.summary-orange{
    background:#fffbeb;
}

.summary-red{
    background:#fef2f2;
}


/* =========================================================
   STATUS BADGES
========================================================= */

.status{
    display:inline-flex;
    align-items:center;
    gap:5px;

    padding:5px 9px;

    border-radius:30px;

    font-size:10px;
    font-weight:800;
}

.status::before{
    content:"";

    width:5px;
    height:5px;

    border-radius:50%;

    background:currentColor;
}

.low{
    background:var(--green-bg);
    color:#15803d;
}

.moderate{
    background:var(--yellow-bg);
    color:#a16207;
}

.heavy,
.active-status{
    background:var(--red-bg);
    color:#b91c1c;
}

.resolved{
    background:var(--green-bg);
    color:#15803d;
}


/* =========================================================
   SYSTEM FLOW
========================================================= */

.flow{
    display:flex;
    align-items:center;
    justify-content:center;

    gap:10px;

    flex-wrap:wrap;
}

.flow-item{
    min-width:125px;

    padding:15px;

    border-radius:11px;

    background:var(--primary-light);
    border:1px solid #bfdbfe;

    color:#1d4ed8;

    text-align:center;

    font-size:12px;
    font-weight:800;
}

.arrow{
    color:#94a3b8;
    font-size:18px;
}


/* =========================================================
   TABLE
========================================================= */

.table-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:10px;

    margin-bottom:14px;
}

.search-box{
    position:relative;

    width:280px;
    max-width:100%;
}

.search-box input{
    width:100%;
    height:38px;

    padding:0 13px 0 36px;

    border:1px solid var(--border);
    border-radius:9px;

    outline:none;

    font-size:12px;
}

.search-box input:focus{
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(37,99,235,.08);
}

.search-icon{
    position:absolute;
    left:12px;
    top:50%;

    transform:translateY(-50%);

    color:#94a3b8;
}

.table-container{
    overflow-x:auto;

    border:1px solid var(--border);
    border-radius:10px;
}

table{
    width:100%;
    border-collapse:collapse;

    min-width:650px;
}

th{
    background:#f8fafc;

    padding:13px 14px;

    text-align:left;

    color:#64748b;

    font-size:10px;
    font-weight:800;

    text-transform:uppercase;
    letter-spacing:.4px;

    white-space:nowrap;
}

td{
    padding:14px;

    border-top:1px solid var(--border);

    font-size:12px;

    color:#334155;
}

tbody tr{
    transition:.15s;
}

tbody tr:hover{
    background:#f8fafc;
}

.empty-row{
    text-align:center;
    color:#94a3b8;
    padding:30px;
}


/* =========================================================
   SIGNALS
========================================================= */

.signal-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:17px;
}

.signal-card{
    border:1px solid var(--border);

    border-radius:14px;

    padding:22px;

    text-align:center;

    background:#fff;

    transition:.2s;
}

.signal-card:hover{
    transform:translateY(-2px);
    box-shadow:var(--shadow);
}

.signal-card h3{
    font-size:14px;
}

.signal-card p{
    color:var(--muted);
    font-size:11px;
    margin-top:5px;
}

.traffic-light{
    width:76px;

    background:#0f172a;

    padding:9px;

    border-radius:15px;

    margin:20px auto;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.08),
        0 8px 20px rgba(15,23,42,.18);
}

.light{
    width:43px;
    height:43px;

    background:#334155;

    border-radius:50%;

    margin:7px auto;

    box-shadow:inset 0 2px 5px rgba(0,0,0,.3);

    transition:.2s;
}

.red-on{
    background:#ef4444;
    box-shadow:0 0 18px rgba(239,68,68,.6);
}

.yellow-on{
    background:#facc15;
    box-shadow:0 0 18px rgba(250,204,21,.6);
}

.green-on{
    background:#22c55e;
    box-shadow:0 0 18px rgba(34,197,94,.6);
}

.signal-state{
    margin-bottom:15px;
}

.signal-state strong{
    font-size:13px;
}


/* =========================================================
   MODAL
========================================================= */

.modal{
    position:fixed;
    inset:0;

    z-index:5000;

    display:none;

    align-items:center;
    justify-content:center;

    padding:20px;

    background:rgba(15,23,42,.55);

    backdrop-filter:blur(5px);
}

.modal.show{
    display:flex;
}

.modal-card{
    width:470px;
    max-width:100%;

    background:#fff;

    border-radius:16px;

    box-shadow:var(--shadow-lg);

    animation:modalIn .2s ease;
}

@keyframes modalIn{
    from{
        opacity:0;
        transform:scale(.96) translateY(8px);
    }
    to{
        opacity:1;
        transform:scale(1) translateY(0);
    }
}

.modal-header{
    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:20px 22px;

    border-bottom:1px solid var(--border);
}

.modal-header h3{
    font-size:16px;
}

.modal-close{
    width:32px;
    height:32px;

    border:0;
    border-radius:8px;

    background:#f1f5f9;

    color:#475569;

    font-size:18px;
}

.modal-body{
    padding:22px;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;

    font-size:11px;
    font-weight:800;

    color:#475569;

    margin-bottom:7px;
}

.form-group input,
.form-group select{
    width:100%;
    height:42px;

    padding:0 12px;

    border:1px solid var(--border);
    border-radius:9px;

    outline:none;

    background:white;

    font-size:12px;
}

.form-group input:focus,
.form-group select:focus{
    border-color:var(--primary);

    box-shadow:0 0 0 3px rgba(37,99,235,.08);
}

.modal-footer{
    display:flex;
    justify-content:flex-end;
    gap:8px;

    padding:16px 22px;

    border-top:1px solid var(--border);
}


/* =========================================================
   TOAST
========================================================= */

#toastContainer{
    position:fixed;

    right:20px;
    bottom:20px;

    z-index:9000;

    display:flex;
    flex-direction:column;

    gap:10px;
}

.toast{
    min-width:270px;
    max-width:360px;

    display:flex;
    align-items:flex-start;
    gap:10px;

    padding:14px 16px;

    background:#fff;

    border:1px solid var(--border);

    border-left:4px solid var(--primary);

    border-radius:10px;

    box-shadow:var(--shadow-lg);

    animation:toastIn .25s ease;
}

.toast.success{
    border-left-color:var(--green);
}

.toast.error{
    border-left-color:var(--red);
}

.toast-title{
    font-weight:800;
    font-size:12px;
}

.toast-message{
    color:var(--muted);
    font-size:11px;
    margin-top:3px;
}

@keyframes toastIn{
    from{
        opacity:0;
        transform:translateX(30px);
    }
    to{
        opacity:1;
        transform:translateX(0);
    }
}


/* =========================================================
   MOBILE OVERLAY
========================================================= */

.sidebar-overlay{
    display:none;

    position:fixed;
    inset:0;

    background:rgba(15,23,42,.45);

    z-index:900;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1150px){

    .cards{
        grid-template-columns:repeat(2,1fr);
    }

    .traffic-grid{
        grid-template-columns:1fr;
